CMakeLists.txt.user
/build
# Out-of-tree build dirs: build-wasm (emcmake), build-asan (sanitizer tests,
# see CLAUDE.md "Tests"), and any other build-<config> tree.
/build-*
# Packaged WASM output, produced by the workflow's packaging step and by
# anyone reproducing the reload test locally.
/dist-wasm
# Packaged macOS .app output, produced by the workflow's packaging step and
# by anyone reproducing it locally (see CI's build-macos job).
/dist-macos
/.vscode
/.claude
/.cache
/.worktrees
/result

# Compiled binaries
/frozen-bubble-sdl3

# Log files
*.log

# Screenshots / scratch images
2-player-names.png
fb2-3-to-5-player.jpg
weird-mini-bubble.png
PHASE1_WALKTHROUGH.md

# Android build output and cache
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
android/local.properties
# Embedded git repos in SDL3 dependencies
android/app/jni/SDL3_mixer/external/ogg/
android/app/jni/SDL3_mixer/external/vorbis/
__pycache__/
# Signing key material must never be committed. See docs/ANDROID_SIGNING.md --
# the key belongs in a password manager and in repository secrets, not here.
*.keystore
*.jks
*.p12
keystore.properties

# docker-compose environment overrides — holds credential file paths (e.g. a
# Discord webhook URL for server/discord-relay/).
docker/.env

# Leftover from the removed push-notification relay -- not used by anything
# now, but never commit whatever is still sitting in here.
docker/push-credentials/
android/app/google-services.json

# Output of tools/build-site.py (the GitHub Pages site, rendered at deploy time)
_site/
.DS_Store

# Scratch working notes for in-progress feature work (superpowers SDD
# ledgers) -- internal process artifacts, not project documentation.
.superpowers/
