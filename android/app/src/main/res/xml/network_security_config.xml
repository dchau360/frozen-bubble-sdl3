<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext allowed for Appodeal (v2.4.x up to the AdMob-only test): some of
     the ad networks it mediates fetched creatives and tracking pixels over
     plain http, which Android 9+ blocks by default. Left on during the test so
     going back to Appodeal is a plain revert; AdMob itself needs none. The game's
     own traffic does not depend on this: the native protocol is a raw TCP
     socket, which this config does not govern. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
