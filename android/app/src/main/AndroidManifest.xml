<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.frozenbubble">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required for Google Play Billing -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Android 13+ requires this at runtime before any notification is shown;
         PushManager.init() asks for it at startup. Declining only means follow
         notifications never appear; everything else is unaffected. Harmless
         on older versions, where it is granted implicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV requirements -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Game controller support -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- AdMob App ID. ${admobAppId} is the real Frozen Bubble app ID
             (created in AdMob 2026-08-24) for a release build, and Google's
             own published always-test App ID for a debug build; see
             build.gradle buildTypes. A debug build (every local/CI build a
             developer runs, on however many devices) must never be able to
             generate a live ad request at all: per-device whitelisting via
             admob.testDeviceId is a second, redundant safety net, not the
             only one. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>

        <!-- Disable AdMob auto-init ContentProvider: MobileAds.initialize() called on SDL
             surfaces conflicts with HWUI thread pool (CommonPool), causing a destroyed-mutex
             crash in hwuiTask threads. Init is deferred until MSG_SHOW_AD is received. -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            android:enabled="false"
            android:exported="false" />

        <!-- Main activity, for TV boxes and phones alike.

             screenOrientation is deliberately not pinned to landscape. One APK
             serves both, and the manifest cannot tell them apart; the game
             picks per device at window creation (SDL_HINT_ORIENTATIONS in
             frozenbubble.cpp: landscape with no touchscreen, portrait with
             one), and SDL's setRequestedOrientation overrides whatever this
             says. Left unspecified so the frames before that use the device's
             own orientation, rather than showing a phone a sideways launch that
             then snaps upright. -->
        <activity
            android:name=".FrozenBubbleActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:screenOrientation="unspecified"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Standard launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
