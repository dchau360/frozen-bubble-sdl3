<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.frozenbubble">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required for Google Play Billing -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Asked for by ad network SDKs (old creative caching), not by the game,
         which writes only to its own app-private directories. Stripped so the
         APK requests no storage access, which Play reviews as a sensitive
         permission and no ad here needs on Android 7+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Android TV requirements -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Game controller support -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:allowBackup">
        <!-- tools:replace: the Appodeal SDK's manifest sets allowBackup to
             true, which would otherwise fail the merge; this app keeps it off. -->

        <!-- Main activity, for TV boxes and phones alike.

             screenOrientation is deliberately not pinned to landscape. One APK
             serves both, and the manifest cannot tell them apart; the game
             picks per device at window creation (SDL_HINT_ORIENTATIONS in
             frozenbubble.cpp: landscape with no touchscreen, portrait with
             one), and SDL's setRequestedOrientation overrides whatever this
             says. Left unspecified so the frames before that use the device's
             own orientation, rather than showing a phone a sideways launch that
             then snaps upright. -->
        <activity
            android:name=".FrozenBubbleActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:screenOrientation="unspecified"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Standard launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
