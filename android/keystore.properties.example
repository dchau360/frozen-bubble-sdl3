# Copy this file to keystore.properties (gitignored -- never commit the
# real one) to let tools/build-android-aab.sh sign a release .aab locally
# without prompting each time. See docs/ANDROID_SIGNING.md.
storeFile=/absolute/path/to/frozen-bubble-release.keystore
storePassword=
keyAlias=frozenbubble
keyPassword=
