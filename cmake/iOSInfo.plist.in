<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>@FB_IOS_EXECUTABLE@</string>
    <key>CFBundleIdentifier</key>
    <string>@FB_IOS_BUNDLE_ID@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Frozen Bubble</string>
    <key>CFBundleDisplayName</key>
    <string>Frozen Bubble</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>iPhoneOS</string>
    </array>

    <!-- Names the icon inside the compiled Assets.car that tools/ios-appicon.sh
         adds after the link. The matching CFBundleIcons / CFBundleIcons~ipad
         dictionaries are merged in by that script from actool's own output,
         rather than written here, so they cannot drift from what the catalog
         actually contains. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>DTPlatformName</key>
    <string>iphoneos</string>
    <key>MinimumOSVersion</key>
    <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>

    <!-- 1 = iPhone/iPod touch, 2 = iPad. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <!-- Joining a server on the same network is a local-network connection, and
         since iOS 14 those are gated behind a privacy prompt. Without this key
         the system has nothing to show the player and denies the connection, so
         LAN play fails with what looks like an unreachable host. Only the
         prompt is covered here: LAN *auto-discovery* additionally needs the
         multicast entitlement, which Apple grants by separate request, so the
         LAN list can stay empty even once this is set -- enter the host's
         address directly. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Frozen Bubble connects to Frozen Bubble game servers on your local network so you can play with people nearby.</string>

    <!-- An empty UILaunchScreen dict is what tells iOS the app is built against
         a modern SDK. Without any launch-screen key the system runs it in
         compatibility mode at a legacy resolution and letterboxes the result,
         so the 640x480 canvas would be scaled twice and end up soft. -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Every orientation is allowed, matching the browser build, which cannot
         lock orientation at all and simply letterboxes whatever it is handed.
         The playfield is a fixed 640x480 canvas, so portrait renders it as a
         band across the middle of the screen rather than filling it -- smaller,
         but playable, and rotating is the player's call rather than ours.
         Taps are mapped through the renderer's letterbox (TouchToLogical), so
         they stay aligned at any aspect ratio. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Without this, UIKit refuses to deliver pointer events and SDL logs
         "You need UIApplicationSupportsIndirectInputEvents in your Info.plist
         for mouse support" at launch. It is what makes a trackpad or Bluetooth
         mouse work on iPad; touch is unaffected either way. -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- App Transport Security blocks plaintext HTTP by default. Two of the
         server-discovery endpoints are http:// only and are not under this
         project's control, so they get named exceptions rather than the blanket
         NSAllowsArbitraryLoads, which would also drop TLS enforcement for the
         GitHub server list. Netplay itself is a raw TCP socket, which ATS does
         not govern at all. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>
            <key>frozen-bubble.org</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
            <key>ip-api.com</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
