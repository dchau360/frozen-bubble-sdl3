<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for APNs. Without this entitlement in the signature,
         registerForRemoteNotifications always fails and the device never gets a
         token, so "follow a server" registers nothing.

         The build itself is unsigned by default (see CMakeLists.txt), which
         means this file does nothing until you sign with it:

           codesign -f -s "Apple Development: you@example.com" \
             --entitlements build-ios/FrozenBubble.entitlements \
             build-ios/FrozenBubble.app

         "development" matches a development provisioning profile and the APNs
         sandbox host; set FB_IOS_APS_ENVIRONMENT=production for a distribution
         profile. A token minted under one is rejected by the other, which is
         the most common reason a correct-looking setup delivers nothing --
         see docs/PUSH_SETUP.md. -->
    <key>aps-environment</key>
    <string>@FB_IOS_APS_ENVIRONMENT@</string>
</dict>
</plist>
